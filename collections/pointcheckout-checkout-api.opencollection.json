                "name": "afterId",
                "value": "",
                "type": "query",
                "description": "filter checkouts after the provided id"
              },
              {
                "name": "afterTimestamp",
                "value": "",
                "type": "query",
                "description": "query checkouts created after specific date/time, date format is `yyyy-mm-dd HH:MM:SS`"
